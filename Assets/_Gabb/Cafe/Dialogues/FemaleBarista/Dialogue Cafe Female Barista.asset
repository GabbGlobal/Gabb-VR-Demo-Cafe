  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cd1abf5930684b46a5a64c1bedd3b33, type: 3}
  m_Name: Dialogue Cafe Female Barista
  m_EditorClassIdentifier: 
  linesOfDialogue:
  - speaker: 0
    text: "Buen d\xEDa. \xBFLe puedo ayudar en algo?"
    audioClip: {fileID: 8300000, guid: 3979023d2fde64d06ae46b5aa4c21809, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Hola. \xBFLe ayudo?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Buen d\xEDa. \xBFLe puedo ayudar en algo?"
      audioClip: {fileID: 8300000, guid: 3979023d2fde64d06ae46b5aa4c21809, type: 3}
    - difficulty: 2
      text: "Buen d\xEDa. \xBFEn qu\xE9 le puedo servir?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Muy buen d\xEDa. \xBFEn qu\xE9 puedo servirle el d\xEDa de hoy?"
      audioClip: {fileID: 0}
  - speaker: 1
    text: "Hola, \xBFpuedo ver el men\xFA por favor?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint1.mp4
    textVariants:
    - difficulty: 0
      text: "Hola. El men\xFA, por favor."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Hola, \xBFpuedo ver el men\xFA por favor?"
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "Hola, \xBFser\xEDa posible ver el men\xFA?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Hola, buenas. \xBFMe podr\xEDa mostrar el men\xFA, por favor?"
      audioClip: {fileID: 0}
  - speaker: 0
    text: "Si, aqu\xED tienes."
    audioClip: {fileID: 8300000, guid: 28acdffb8abed4b64ac636a0c75f1aeb, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "S\xED, aqu\xED est\xE1."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Si, aqu\xED tienes."
      audioClip: {fileID: 8300000, guid: 28acdffb8abed4b64ac636a0c75f1aeb, type: 3}
    - difficulty: 2
      text: "Por supuesto, aqu\xED lo tienes."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Claro que s\xED, aqu\xED te lo dejo para que le eches un vistazo."
      audioClip: {fileID: 0}
  - speaker: 1
    text: "Quiero un caf\xE9 con leche por favor."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint2.mp4
    textVariants:
    - difficulty: 0
      text: "Un caf\xE9 con leche, por favor."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Quiero un caf\xE9 con leche por favor."
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "Me gustar\xEDa pedir un caf\xE9 con leche, por favor."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Quisiera ordenar un caf\xE9 con leche, si es tan amable."
      audioClip: {fileID: 0}
  - speaker: 0
    text: "\xBFAlgo para comer con eso?"
    audioClip: {fileID: 8300000, guid: 018f31e55761846229d57a3991fb318e, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFQuieres comer algo?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "\xBFAlgo para comer con eso?"
      audioClip: {fileID: 8300000, guid: 018f31e55761846229d57a3991fb318e, type: 3}
    - difficulty: 2
      text: "\xBFLe gustar\xEDa a\xF1adir algo de comer?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "\xBFDesear\xEDa acompa\xF1ar su caf\xE9 con algo para picar?"
      audioClip: {fileID: 0}
  - speaker: 1
    text: "S\xED, me gustar\xEDa un s\xE1ndwich de huevo."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint3.mp4
    textVariants:
    - difficulty: 0
      text: "S\xED, un s\xE1ndwich de huevo."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "S\xED, me gustar\xEDa un s\xE1ndwich de huevo."
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "S\xED, por favor, p\xF3ngame un s\xE1ndwich de huevo."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "S\xED, me encantar\xEDa que me pusiera un s\xE1ndwich de huevo, por favor."
      audioClip: {fileID: 0}
  - speaker: 0
    text: "\xBFAlgo m\xE1s?"
    audioClip: {fileID: 8300000, guid: 79a30a3a099f24d58a51dc4659390018, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFAlgo m\xE1s?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "\xBFAlgo m\xE1s?"
      audioClip: {fileID: 8300000, guid: 79a30a3a099f24d58a51dc4659390018, type: 3}
    - difficulty: 2
      text: "\xBFDesea algo m\xE1s?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "\xBFHay algo m\xE1s que le pueda ofrecer?"
      audioClip: {fileID: 0}
  - speaker: 1
    text: "\xBFQu\xE9 clase de panecillo es ese?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint4.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFQu\xE9 es eso?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "\xBFQu\xE9 clase de panecillo es ese?"
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "\xBFMe podr\xEDa decir qu\xE9 tipo de panecillo es ese?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Disculpe, \xBFle importar\xEDa decirme qu\xE9 clase de panecillo es el que tienen ah\xED?"
      audioClip: {fileID: 0}
  - speaker: 0
    text: "Es un muffin de ar\xE1ndanos. \xBFQuieres uno?"
    audioClip: {fileID: 8300000, guid: 22db9b2e0ebe645c88d19525202c0b0a, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Es un muffin. \xBFQuieres uno?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Es un muffin de ar\xE1ndanos. \xBFQuieres uno?"
      audioClip: {fileID: 8300000, guid: 22db9b2e0ebe645c88d19525202c0b0a, type: 3}
    - difficulty: 2
      text: "Es un muffin de ar\xE1ndanos. \xBFLe gustar\xEDa probar uno?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Ese es un muffin de ar\xE1ndanos reci\xE9n hecho. \xBFLe apetece uno?"
      audioClip: {fileID: 0}
  - speaker: 1
    text: No gracias, hoy no.
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint5.mp4
    textVariants:
    - difficulty: 0
      text: No gracias.
      audioClip: {fileID: 0}
    - difficulty: 1
      text: No gracias, hoy no.
      audioClip: {fileID: 0}
    - difficulty: 2
      text: No, muchas gracias, hoy no.
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Se lo agradezco, pero hoy no me apetece."
      audioClip: {fileID: 0}
  - speaker: 0
    text: "Ok, ser\xE1n cinco d\xF3lares con cuarenta y siete centavos."
    audioClip: {fileID: 8300000, guid: 931679e3a41b74475a4be79dde66ddb6, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Son cinco d\xF3lares y cuarenta y siete centavos."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Ok, ser\xE1n cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 8300000, guid: 931679e3a41b74475a4be79dde66ddb6, type: 3}
    - difficulty: 2
      text: "Muy bien, el total ser\xE1 cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Perfecto, entonces el total le quedar\xEDa en cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 0}
  - speaker: 1
    text: "\xBFPuedo pagar con tarjeta?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint6.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFCon tarjeta?"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "\xBFPuedo pagar con tarjeta?"
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "\xBFEs posible pagar con tarjeta de cr\xE9dito?"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "\xBFTendr\xEDan la posibilidad de cobrarme con tarjeta?"
      audioClip: {fileID: 0}
  - speaker: 0
    text: "No, s\xF3lo aceptamos efectivo."
    audioClip: {fileID: 8300000, guid: 66c7fb690903c434c8b55eda7031de5a, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "No, solo efectivo."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "No, s\xF3lo aceptamos efectivo."
      audioClip: {fileID: 8300000, guid: 66c7fb690903c434c8b55eda7031de5a, type: 3}
    - difficulty: 2
      text: "Lo siento, solamente aceptamos pagos en efectivo."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Disculpe, lamentablemente por el momento solo manejamos pagos en efectivo."
      audioClip: {fileID: 0}
  - speaker: 1
    text: "Bien, aqu\xED tienes. Aqu\xED tienes seis d\xF3lares."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint7.mp4
    textVariants:
    - difficulty: 0
      text: "Ok. Aqu\xED tienes seis d\xF3lares."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Bien, aqu\xED tienes. Aqu\xED tienes seis d\xF3lares."
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "Est\xE1 bien, aqu\xED tienes. Te doy seis d\xF3lares."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "No hay problema, aqu\xED tienes. Te paso seis d\xF3lares justos."
      audioClip: {fileID: 0}
  - speaker: 0
    text: "Aqu\xED tienes el cambio, cincuenta y tres centavos."
    audioClip: {fileID: 8300000, guid: 915f717eade2a4d7aa7e79ff2897b2fb, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Tu cambio: cincuenta y tres centavos."
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "Aqu\xED tienes el cambio, cincuenta y tres centavos."
      audioClip: {fileID: 8300000, guid: 915f717eade2a4d7aa7e79ff2897b2fb, type: 3}
    - difficulty: 2
      text: "Aqu\xED tienes tu cambio, son cincuenta y tres centavos."
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "Aqu\xED le devuelvo el cambio, que ser\xEDan cincuenta y tres centavos."
      audioClip: {fileID: 0}
  - speaker: 1
    text: "\xA1Gracias!"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint8.mp4
    textVariants:
    - difficulty: 0
      text: "\xA1Gracias!"
      audioClip: {fileID: 0}
    - difficulty: 1
      text: "\xA1Gracias!"
      audioClip: {fileID: 0}
    - difficulty: 2
      text: "\xA1Gracias!"
      audioClip: {fileID: 0}
    - difficulty: 3
      text: "\xA1Gracias!"
      audioClip: {fileID: 0}
