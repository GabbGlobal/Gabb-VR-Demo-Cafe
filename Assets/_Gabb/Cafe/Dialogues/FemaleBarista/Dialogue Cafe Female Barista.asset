  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cd1abf5930684b46a5a64c1bedd3b33, type: 3}
  m_Name: Dialogue Cafe Female Barista
  m_EditorClassIdentifier: 
  linesOfDialogue:
  - speaker: 0
    text: "Buen d\xEDa. \xBFLe puedo ayudar en algo?"
    audioClip: {fileID: 8300000, guid: 3979023d2fde64d06ae46b5aa4c21809, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Hola. \xBFLe ayudo?"
      audioClip: {fileID: 8300000, guid: 082c2b1fbb9e470e917fdd778a1b004d, type: 3}
    - difficulty: 1
      text: "Buen d\xEDa. \xBFLe puedo ayudar en algo?"
      audioClip: {fileID: 8300000, guid: 6153a321d3c349c6976132fd64edec40, type: 3}
    - difficulty: 2
      text: "Buen d\xEDa. \xBFEn qu\xE9 le puedo servir?"
      audioClip: {fileID: 8300000, guid: 7dc76a27056145c7a05f640bd0b9b3b7, type: 3}
    - difficulty: 3
      text: "Muy buen d\xEDa. \xBFEn qu\xE9 puedo servirle el d\xEDa de hoy?"
      audioClip: {fileID: 8300000, guid: 29a562ed6bcf488aa34184da7029af4d, type: 3}
  - speaker: 1
    text: "Hola, \xBFpuedo ver el men\xFA por favor?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint1.mp4
    textVariants:
    - difficulty: 0
      text: "Hola. El men\xFA, por favor."
      audioClip: {fileID: 8300000, guid: 7cef2e881ea84923971f20c1a83d766d, type: 3}
    - difficulty: 1
      text: "Hola, \xBFpuedo ver el men\xFA por favor?"
      audioClip: {fileID: 8300000, guid: 6b619ad58b86439db0b11cf6ddaa3614, type: 3}
    - difficulty: 2
      text: "Hola, \xBFser\xEDa posible ver el men\xFA?"
      audioClip: {fileID: 8300000, guid: b0646cce71814400bbbc2bf0845a8c2f, type: 3}
    - difficulty: 3
      text: "Hola, buenas. \xBFMe podr\xEDa mostrar el men\xFA, por favor?"
      audioClip: {fileID: 8300000, guid: 60eab6f9e01f45d092436d33d51274f3, type: 3}
  - speaker: 0
    text: "Si, aqu\xED tienes."
    audioClip: {fileID: 8300000, guid: 28acdffb8abed4b64ac636a0c75f1aeb, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "S\xED, aqu\xED est\xE1."
      audioClip: {fileID: 8300000, guid: be1d3a1870a745e8ad83b7a9b3397aad, type: 3}
    - difficulty: 1
      text: "Si, aqu\xED tienes."
      audioClip: {fileID: 8300000, guid: f2653033503d4aeebb912d48d7fc7d0d, type: 3}
    - difficulty: 2
      text: "Por supuesto, aqu\xED lo tienes."
      audioClip: {fileID: 8300000, guid: 67d07426972e4421981aee193372ea86, type: 3}
    - difficulty: 3
      text: "Claro que s\xED, aqu\xED te lo dejo para que le eches un vistazo."
      audioClip: {fileID: 8300000, guid: 070452eb74d54c3eaeea96fb07121c7e, type: 3}
  - speaker: 1
    text: "Quiero un caf\xE9 con leche por favor."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint2.mp4
    textVariants:
    - difficulty: 0
      text: "Un caf\xE9 con leche, por favor."
      audioClip: {fileID: 8300000, guid: 4607d1330e944c428564226f71b05d6a, type: 3}
    - difficulty: 1
      text: "Quiero un caf\xE9 con leche por favor."
      audioClip: {fileID: 8300000, guid: 955fd18471514c169537f74da578da60, type: 3}
    - difficulty: 2
      text: "Me gustar\xEDa pedir un caf\xE9 con leche, por favor."
      audioClip: {fileID: 8300000, guid: 49b9adc08fbe481ba8b50444ed04499d, type: 3}
    - difficulty: 3
      text: "Quisiera ordenar un caf\xE9 con leche, si es tan amable."
      audioClip: {fileID: 8300000, guid: 28a9cc6a8ada4d64b6270e1a9a718221, type: 3}
  - speaker: 0
    text: "\xBFAlgo para comer con eso?"
    audioClip: {fileID: 8300000, guid: 018f31e55761846229d57a3991fb318e, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFQuieres comer algo?"
      audioClip: {fileID: 8300000, guid: 9e437fe091ad4fe6a3fa14a95936644b, type: 3}
    - difficulty: 1
      text: "\xBFAlgo para comer con eso?"
      audioClip: {fileID: 8300000, guid: 8f913def1b86426ab241889f0bcc8020, type: 3}
    - difficulty: 2
      text: "\xBFLe gustar\xEDa a\xF1adir algo de comer?"
      audioClip: {fileID: 8300000, guid: 61c747722ab9412ea16f57454fe8f54b, type: 3}
    - difficulty: 3
      text: "\xBFDesear\xEDa acompa\xF1ar su caf\xE9 con algo para picar?"
      audioClip: {fileID: 8300000, guid: a350de1c08be4dcb97231c91d4afc619, type: 3}
  - speaker: 1
    text: "S\xED, me gustar\xEDa un s\xE1ndwich de huevo."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint3.mp4
    textVariants:
    - difficulty: 0
      text: "S\xED, un s\xE1ndwich de huevo."
      audioClip: {fileID: 8300000, guid: bdf94b90475948b9acebdb7a90689b32, type: 3}
    - difficulty: 1
      text: "S\xED, me gustar\xEDa un s\xE1ndwich de huevo."
      audioClip: {fileID: 8300000, guid: ced62f69d2ba475590fbd4c0aa72fbfc, type: 3}
    - difficulty: 2
      text: "S\xED, por favor, p\xF3ngame un s\xE1ndwich de huevo."
      audioClip: {fileID: 8300000, guid: 60bbca0b8d104e8bbe40d56bc893f048, type: 3}
    - difficulty: 3
      text: "S\xED, me encantar\xEDa que me pusiera un s\xE1ndwich de huevo, por favor."
      audioClip: {fileID: 8300000, guid: ee945ab9e8c742d6aabea8a9edf8b367, type: 3}
  - speaker: 0
    text: "\xBFAlgo m\xE1s?"
    audioClip: {fileID: 8300000, guid: 79a30a3a099f24d58a51dc4659390018, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFAlgo m\xE1s?"
      audioClip: {fileID: 8300000, guid: 5927a85a00594749865c8577dab201da, type: 3}
    - difficulty: 1
      text: "\xBFAlgo m\xE1s?"
      audioClip: {fileID: 8300000, guid: 9fad181540954305ab424fb4f83589ef, type: 3}
    - difficulty: 2
      text: "\xBFDesea algo m\xE1s?"
      audioClip: {fileID: 8300000, guid: 88bd49d6a01b4bb98f25507125761ff8, type: 3}
    - difficulty: 3
      text: "\xBFHay algo m\xE1s que le pueda ofrecer?"
      audioClip: {fileID: 8300000, guid: f416d84bd5c944b796fe35b0f01558d6, type: 3}
  - speaker: 1
    text: "\xBFQu\xE9 clase de panecillo es ese?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint4.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFQu\xE9 es eso?"
      audioClip: {fileID: 8300000, guid: 75084ffe21b4484cbd5cf5364c94e224, type: 3}
    - difficulty: 1
      text: "\xBFQu\xE9 clase de panecillo es ese?"
      audioClip: {fileID: 8300000, guid: b4cebdabf0b745ac878ff6752882214b, type: 3}
    - difficulty: 2
      text: "\xBFMe podr\xEDa decir qu\xE9 tipo de panecillo es ese?"
      audioClip: {fileID: 8300000, guid: 1452adbf29574488802e46fdc6c0eca3, type: 3}
    - difficulty: 3
      text: "Disculpe, \xBFle importar\xEDa decirme qu\xE9 clase de panecillo es el que tienen ah\xED?"
      audioClip: {fileID: 8300000, guid: bf011c47b6934df1ae35b910b42407c3, type: 3}
  - speaker: 0
    text: "Es un muffin de ar\xE1ndanos. \xBFQuieres uno?"
    audioClip: {fileID: 8300000, guid: 22db9b2e0ebe645c88d19525202c0b0a, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Es un muffin. \xBFQuieres uno?"
      audioClip: {fileID: 8300000, guid: d1d6320475b04f9fb17498e5de27f01e, type: 3}
    - difficulty: 1
      text: "Es un muffin de ar\xE1ndanos. \xBFQuieres uno?"
      audioClip: {fileID: 8300000, guid: a0ddf524ff2f4b8cbf835746126b9ac9, type: 3}
    - difficulty: 2
      text: "Es un muffin de ar\xE1ndanos. \xBFLe gustar\xEDa probar uno?"
      audioClip: {fileID: 8300000, guid: eefbe53d815244bbbd1b420fb956526b, type: 3}
    - difficulty: 3
      text: "Ese es un muffin de ar\xE1ndanos reci\xE9n hecho. \xBFLe apetece uno?"
      audioClip: {fileID: 8300000, guid: 35cc420fa9254e00beddf49cd5ac1944, type: 3}
  - speaker: 1
    text: No gracias, hoy no.
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint5.mp4
    textVariants:
    - difficulty: 0
      text: No gracias.
      audioClip: {fileID: 8300000, guid: 67d3fe22f4ff4307b0d1a0412daca316, type: 3}
    - difficulty: 1
      text: No gracias, hoy no.
      audioClip: {fileID: 8300000, guid: 24e3133f7e30441a80e1679293a8e160, type: 3}
    - difficulty: 2
      text: No, muchas gracias, hoy no.
      audioClip: {fileID: 8300000, guid: d1e6cfbdd982447fbf14fb303303a0f1, type: 3}
    - difficulty: 3
      text: "Se lo agradezco, pero hoy no me apetece."
      audioClip: {fileID: 8300000, guid: b0629cf64346475ca666f24ec474cab6, type: 3}
  - speaker: 0
    text: "Ok, ser\xE1n cinco d\xF3lares con cuarenta y siete centavos."
    audioClip: {fileID: 8300000, guid: 931679e3a41b74475a4be79dde66ddb6, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Son cinco d\xF3lares y cuarenta y siete centavos."
      audioClip: {fileID: 8300000, guid: 0376e0be89b94fbf93e0b68433c42076, type: 3}
    - difficulty: 1
      text: "Ok, ser\xE1n cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 8300000, guid: df37fb6fc77a4fcdb79c72b25b1d2e45, type: 3}
    - difficulty: 2
      text: "Muy bien, el total ser\xE1 cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 8300000, guid: 2e98f020f6fe4d10bebdb65f20e5a396, type: 3}
    - difficulty: 3
      text: "Perfecto, entonces el total le quedar\xEDa en cinco d\xF3lares con cuarenta y siete centavos."
      audioClip: {fileID: 8300000, guid: 67710e822437463bbd201851550965a8, type: 3}
  - speaker: 1
    text: "\xBFPuedo pagar con tarjeta?"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint6.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFCon tarjeta?"
      audioClip: {fileID: 8300000, guid: 0d3af9463e644faea4a100b54823a248, type: 3}
    - difficulty: 1
      text: "\xBFPuedo pagar con tarjeta?"
      audioClip: {fileID: 8300000, guid: 0dd090eca3bb4e80affa76be51d5c57b, type: 3}
    - difficulty: 2
      text: "\xBFEs posible pagar con tarjeta de cr\xE9dito?"
      audioClip: {fileID: 8300000, guid: 8795cea6f76b4fc7a195e36705f77149, type: 3}
    - difficulty: 3
      text: "\xBFTendr\xEDan la posibilidad de cobrarme con tarjeta?"
      audioClip: {fileID: 8300000, guid: 1bc496724dc94c818b95850e605381a7, type: 3}
  - speaker: 0
    text: "No, s\xF3lo aceptamos efectivo."
    audioClip: {fileID: 8300000, guid: 66c7fb690903c434c8b55eda7031de5a, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "No, solo efectivo."
      audioClip: {fileID: 8300000, guid: 63fe8b70efef46ffa1f8044ab3620624, type: 3}
    - difficulty: 1
      text: "No, s\xF3lo aceptamos efectivo."
      audioClip: {fileID: 8300000, guid: 75d85eb77cae43c09fa1dffb41469da2, type: 3}
    - difficulty: 2
      text: "Lo siento, solamente aceptamos pagos en efectivo."
      audioClip: {fileID: 8300000, guid: 3b0a099a06cf4694bd12e5e92c096745, type: 3}
    - difficulty: 3
      text: "Disculpe, lamentablemente por el momento solo manejamos pagos en efectivo."
      audioClip: {fileID: 8300000, guid: 15888b4801cc47478229368e96b2d07f, type: 3}
  - speaker: 1
    text: "Bien, aqu\xED tienes. Aqu\xED tienes seis d\xF3lares."
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint7.mp4
    textVariants:
    - difficulty: 0
      text: "Ok. Aqu\xED tienes seis d\xF3lares."
      audioClip: {fileID: 8300000, guid: 41f51ca2b1504e3ca2378f54a6271259, type: 3}
    - difficulty: 1
      text: "Bien, aqu\xED tienes. Aqu\xED tienes seis d\xF3lares."
      audioClip: {fileID: 8300000, guid: 00917fdbb5a3499f97e7d981c52d8f44, type: 3}
    - difficulty: 2
      text: "Est\xE1 bien, aqu\xED tienes. Te doy seis d\xF3lares."
      audioClip: {fileID: 8300000, guid: d6ab4bdd1dbd474ca4f0164ca47a957e, type: 3}
    - difficulty: 3
      text: "No hay problema, aqu\xED tienes. Te paso seis d\xF3lares justos."
      audioClip: {fileID: 8300000, guid: 8a6d8616acf74e62bb356b348af219c3, type: 3}
  - speaker: 0
    text: "Aqu\xED tienes el cambio, cincuenta y tres centavos."
    audioClip: {fileID: 8300000, guid: 915f717eade2a4d7aa7e79ff2897b2fb, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Tu cambio: cincuenta y tres centavos."
      audioClip: {fileID: 8300000, guid: 834b8e34821544b38e621feb8e437678, type: 3}
    - difficulty: 1
      text: "Aqu\xED tienes el cambio, cincuenta y tres centavos."
      audioClip: {fileID: 8300000, guid: a2e5cd3974504b2695fc055a4eae2df2, type: 3}
    - difficulty: 2
      text: "Aqu\xED tienes tu cambio, son cincuenta y tres centavos."
      audioClip: {fileID: 8300000, guid: 84f85bb22dd04a4cbe660fc4bfd35332, type: 3}
    - difficulty: 3
      text: "Aqu\xED le devuelvo el cambio, que ser\xEDan cincuenta y tres centavos."
      audioClip: {fileID: 8300000, guid: 54c5e0a9e8ad4860a3661cba4d2dac69, type: 3}
  - speaker: 1
    text: "\xA1Gracias!"
    audioClip: {fileID: 0}
    hintVideoPath: FemaleBaristaHints/conversation8_version1_hint8.mp4
    textVariants:
    - difficulty: 0
      text: "\xA1Gracias!"
      audioClip: {fileID: 8300000, guid: c869a09db90d4e66a907815a6dcfb37e, type: 3}
    - difficulty: 1
      text: "\xA1Gracias!"
      audioClip: {fileID: 8300000, guid: 3c945f6d2f56493488959385e814e926, type: 3}
    - difficulty: 2
      text: "\xA1Gracias!"
      audioClip: {fileID: 8300000, guid: 86d7708ab16d4967afa12d1778936c2f, type: 3}
    - difficulty: 3
      text: "\xA1Gracias!"
      audioClip: {fileID: 8300000, guid: e93c3d3370604510a9971e45af74da3f, type: 3}
