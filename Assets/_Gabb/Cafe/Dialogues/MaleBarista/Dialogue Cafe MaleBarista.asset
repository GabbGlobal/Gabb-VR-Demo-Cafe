  m_Script: {fileID: 11500000, guid: 5cd1abf5930684b46a5a64c1bedd3b33, type: 3}
  m_Name: Dialogue Cafe MaleBarista
  m_EditorClassIdentifier: 
  linesOfDialogue:
  - speaker: 0
    text: "Hola, \xBFqu\xE9 te gustar\xEDa tomar hoy?"
    audioClip: {fileID: 8300000, guid: e603a3fa12ca446a88d6596cc75c8519, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Hola, \xBFqu\xE9 quieres tomar?"
      audioClip: {fileID: 8300000, guid: 4cfcc72649ea48afabe2455cbec78a53, type: 3}
    - difficulty: 1
      text: "Hola, \xBFqu\xE9 te gustar\xEDa tomar hoy?"
      audioClip: {fileID: 8300000, guid: 8dcf25ffd095456baecbb9d8b2db80f6, type: 3}
    - difficulty: 2
      text: "Buen d\xEDa, \xBFqu\xE9 te apetecer\xEDa tomar el d\xEDa de hoy?"
      audioClip: {fileID: 8300000, guid: a75b5aeb504946d3b320856b052fca3e, type: 3}
    - difficulty: 3
      text: "Buenas, \xBFqu\xE9 te puedo ofrecer para tomar en esta ma\xF1ana tan bonita?"
      audioClip: {fileID: 8300000, guid: 53a64f6934104526a1342e9d4e4b2a74, type: 3}
  - speaker: 1
    text: "\xBFQu\xE9 tipos de t\xE9 tienes?"
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint1.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFQu\xE9 t\xE9 tienes?"
      audioClip: {fileID: 8300000, guid: 3771dee6250746bab677991986973127, type: 3}
    - difficulty: 1
      text: "\xBFQu\xE9 tipos de t\xE9 tienes?"
      audioClip: {fileID: 8300000, guid: 76874530cb764b0081794b185ec74204, type: 3}
    - difficulty: 2
      text: "\xBFQu\xE9 variedades de t\xE9 manejan?"
      audioClip: {fileID: 8300000, guid: 73722442f3634829a69d86172ec4f683, type: 3}
    - difficulty: 3
      text: "\xBFMe podr\xEDas decir qu\xE9 opciones de t\xE9 tienen disponibles?"
      audioClip: {fileID: 8300000, guid: 9070fdde440b4c79bc0068d38751c63d, type: 3}
  - speaker: 0
    text: "Nosotros tenemos t\xE9 negro y t\xE9 verde."
    audioClip: {fileID: 8300000, guid: cc38d09f8f7d343549ec2f2b81365381, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Tenemos t\xE9 negro y t\xE9 verde."
      audioClip: {fileID: 8300000, guid: ec126a403b584cddb0bb70a169e3eb82, type: 3}
    - difficulty: 1
      text: "Nosotros tenemos t\xE9 negro y t\xE9 verde."
      audioClip: {fileID: 8300000, guid: b9bd5c1b431a40de81ca63f7a066e2eb, type: 3}
    - difficulty: 2
      text: "Contamos con t\xE9 negro y t\xE9 verde."
      audioClip: {fileID: 8300000, guid: e3b915821510422eaf577013fdaed741, type: 3}
    - difficulty: 3
      text: "Mira, lo que manejamos ahorita es t\xE9 negro y t\xE9 verde."
      audioClip: {fileID: 8300000, guid: 4bbc660b4d734db9a6e944aa1004846c, type: 3}
  - speaker: 1
    text: "\xBFPodr\xEDa darme un t\xE9 negro, por favor"
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint2.mp4
    textVariants:
    - difficulty: 0
      text: "Un t\xE9 negro, por favor."
      audioClip: {fileID: 8300000, guid: ffa385a822944e9c89deeef523f0688b, type: 3}
    - difficulty: 1
      text: "\xBFPodr\xEDa darme un t\xE9 negro, por favor"
      audioClip: {fileID: 8300000, guid: ddbbf468182f4411bfaffebfc9c58435, type: 3}
    - difficulty: 2
      text: "\xBFSer\xEDa posible que me diera un t\xE9 negro, por favor?"
      audioClip: {fileID: 8300000, guid: d1e3b4dc755d45d68300c882c130a9b9, type: 3}
    - difficulty: 3
      text: "\xBFMe har\xEDas el favor de prepararme un t\xE9 negro?"
      audioClip: {fileID: 8300000, guid: eb4151f6ce7342bf9d24cd4c73886528, type: 3}
  - speaker: 0
    text: "Claro, \xBFalgo para comer con eso? \xBFQuieres una galleta o un muffin?"
    audioClip: {fileID: 8300000, guid: 0c0d92f48c0b4403692593f24f459fd0, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFS\xED! \xBFQuieres comer algo? Tenemos galletas y muffins."
      audioClip: {fileID: 8300000, guid: fcb2ac336d684c7c9310df5126866735, type: 3}
    - difficulty: 1
      text: "Claro, \xBFalgo para comer con eso? \xBFQuieres una galleta o un muffin?"
      audioClip: {fileID: 8300000, guid: 772aa6f39f4d4f179e4264933122a235, type: 3}
    - difficulty: 2
      text: "Por supuesto, \xBFte gustar\xEDa acompa\xF1arlo con algo de comer? Tenemos galletas y muffins."
      audioClip: {fileID: 8300000, guid: fd0274107ed8455b9e3bfddfd195a65f, type: 3}
    - difficulty: 3
      text: "\xA1Claro que s\xED! \xBFNo se te antoja algo para acompa\xF1ar el t\xE9? Te puedo ofrecer una galleta o un muffin."
      audioClip: {fileID: 8300000, guid: 6a521c09c2bb42978fc17fb0966294aa, type: 3}
  - speaker: 1
    text: "\xBFQu\xE9 tipo de galletas tienes?"
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint3.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFQu\xE9 galletas tienes?"
      audioClip: {fileID: 8300000, guid: f36644f9ebf147c19376e833fc8cb335, type: 3}
    - difficulty: 1
      text: "\xBFQu\xE9 tipo de galletas tienes?"
      audioClip: {fileID: 8300000, guid: a46c4f7a39804e00a274234bd67919b2, type: 3}
    - difficulty: 2
      text: "\xBFQu\xE9 tipos de galletas manejan?"
      audioClip: {fileID: 8300000, guid: 2b4e30c78632408a8cadfe24fa484abe, type: 3}
    - difficulty: 3
      text: "\xBFMe podr\xEDas decir qu\xE9 galletas tienen disponibles?"
      audioClip: {fileID: 8300000, guid: 4a6abdffebae4cf5a13b334f50c3343c, type: 3}
  - speaker: 0
    text: "Nosotros tenemos galletas de mantequilla de man\xED."
    audioClip: {fileID: 8300000, guid: 9b69c931cbc2a44d9bc926cf084e9c73, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Tenemos galletas de mantequilla de man\xED."
      audioClip: {fileID: 8300000, guid: 08bf5380ca7e4511ba768bd0f7a1744a, type: 3}
    - difficulty: 1
      text: "Nosotros tenemos galletas de mantequilla de man\xED."
      audioClip: {fileID: 8300000, guid: eac27d54692144deb5d631803c6cbc5c, type: 3}
    - difficulty: 2
      text: "Contamos con galletas de mantequilla de man\xED."
      audioClip: {fileID: 8300000, guid: 5b0ab3ef77504917913149fc4f16cedd, type: 3}
    - difficulty: 3
      text: "Lo que manejamos ahorita son galletas de mantequilla de man\xED."
      audioClip: {fileID: 8300000, guid: 9f8142928bfa4cfeb8e36b4048561763, type: 3}
  - speaker: 1
    text: "Quiero una galleta de mantequilla de man\xED, por favor."
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint4.mp4
    textVariants:
    - difficulty: 0
      text: "Una galleta de man\xED, por favor."
      audioClip: {fileID: 8300000, guid: d45b1fab9c9343479e3a5e871c01f700, type: 3}
    - difficulty: 1
      text: "Quiero una galleta de mantequilla de man\xED, por favor."
      audioClip: {fileID: 8300000, guid: 012c965441f54f719ce61f4885657cea, type: 3}
    - difficulty: 2
      text: "Me gustar\xEDa una galleta de mantequilla de man\xED, por favor."
      audioClip: {fileID: 8300000, guid: cbde44fd45434b9b89b3a37b173b4030, type: 3}
    - difficulty: 3
      text: "Entonces me voy a llevar una galleta de mantequilla de man\xED, si no es mucha molestia."
      audioClip: {fileID: 8300000, guid: f6d264f394d44ddb98ce99f11a407b3a, type: 3}
  - speaker: 0
    text: "\xBFEso ser\xEDa todo?"
    audioClip: {fileID: 8300000, guid: 9416c98306209483ab0fee2dbd28c0ad, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xBFAlgo m\xE1s?"
      audioClip: {fileID: 8300000, guid: 4a08a540463e4ab28a3306cfd073232c, type: 3}
    - difficulty: 1
      text: "\xBFEso ser\xEDa todo?"
      audioClip: {fileID: 8300000, guid: 245b931bf41346c4bf17256f4459025b, type: 3}
    - difficulty: 2
      text: "\xBFEso ser\xEDa todo por hoy?"
      audioClip: {fileID: 8300000, guid: 135fb74792614266b07970acc7958668, type: 3}
    - difficulty: 3
      text: "\xBFTe puedo ofrecer algo m\xE1s o ser\xEDa todo?"
      audioClip: {fileID: 8300000, guid: 9d8b426fbcb84406ad961644efa46372, type: 3}
  - speaker: 1
    text: "Si, eso es. Cu\xE1nto cuesta."
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint5.mp4
    textVariants:
    - difficulty: 0
      text: "S\xED. \xBFCu\xE1nto es?"
      audioClip: {fileID: 8300000, guid: 3833bbbf38d547d6b648f44697c62154, type: 3}
    - difficulty: 1
      text: "Si, eso es. Cu\xE1nto cuesta."
      audioClip: {fileID: 8300000, guid: 9abea0982a224be088ad881897d2cf38, type: 3}
    - difficulty: 2
      text: "S\xED, eso es todo. \xBFCu\xE1nto le debo?"
      audioClip: {fileID: 8300000, guid: 66ca55737a4543d387832e91c62aa6df, type: 3}
    - difficulty: 3
      text: "No, eso ser\xEDa todo. \xBFCu\xE1nto te debo en total?"
      audioClip: {fileID: 8300000, guid: acb6d57abe2e458c81bb70e0caec8ca4, type: 3}
  - speaker: 0
    text: "Ser\xE1n cuatro d\xF3lares y sesenta centavos."
    audioClip: {fileID: 8300000, guid: 956d6cfb9fcc04c9d8910af66439b5c1, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Son cuatro d\xF3lares con sesenta."
      audioClip: {fileID: 8300000, guid: 90398ea47aa1495a82981808ae37ed90, type: 3}
    - difficulty: 1
      text: "Ser\xE1n cuatro d\xF3lares y sesenta centavos."
      audioClip: {fileID: 8300000, guid: 022c294c9ac340659383a4ac6d9387bd, type: 3}
    - difficulty: 2
      text: "El total ser\xEDa cuatro d\xF3lares con sesenta centavos."
      audioClip: {fileID: 8300000, guid: a4bd56e92f1e4f1b8547ad1b81ea5077, type: 3}
    - difficulty: 3
      text: "Te sale en cuatro d\xF3lares con sesenta centavos el total."
      audioClip: {fileID: 8300000, guid: e2ed5d90e711489283b273603204bef3, type: 3}
  - speaker: 1
    text: "Aqu\xED tienes."
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint6.mp4
    textVariants:
    - difficulty: 0
      text: "Aqu\xED tienes."
      audioClip: {fileID: 8300000, guid: 7484e442e4ea4477924a18e4d9bb0649, type: 3}
    - difficulty: 1
      text: "Aqu\xED tienes."
      audioClip: {fileID: 8300000, guid: 5651ff621bdc4b0d9c75a81eedb75027, type: 3}
    - difficulty: 2
      text: "Aqu\xED tienes."
      audioClip: {fileID: 8300000, guid: 847690a0e6c049c7b30bd99532d4b504, type: 3}
    - difficulty: 3
      text: "Aqu\xED tienes, qu\xE9date con el cambio."
      audioClip: {fileID: 8300000, guid: d0e8016926e04486b51d532a9abe42ae, type: 3}
  - speaker: 0
    text: "Gracias. Aqu\xED tienes: tu t\xE9 y tu galleta. \xA1Que tenga un buen
      d\xEDa!"
    audioClip: {fileID: 8300000, guid: 1062618bd381f4c54b3b43ae810a1554, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Gracias. Tu t\xE9 y tu galleta. \xA1Buen d\xEDa!"
      audioClip: {fileID: 8300000, guid: 5ff7bd0dbcc94e4693c97f2490350251, type: 3}
    - difficulty: 1
      text: "Gracias. Aqu\xED tienes: tu t\xE9 y tu galleta. \xA1Que tenga un buen
      d\xEDa!"
      audioClip: {fileID: 8300000, guid: 6ae62ca8aaac4884ac22a06e912bbfe5, type: 3}
    - difficulty: 2
      text: "Muchas gracias. Aqu\xED tienes tu t\xE9 y tu galleta. \xA1Que tenga un excelente d\xEDa!"
      audioClip: {fileID: 8300000, guid: 286bf75851bc4f4fb639d58970ac8caf, type: 3}
    - difficulty: 3
      text: "\xA1Muchas gracias! Aqu\xED te dejo tu tecito y tu galleta. \xA1Que te vaya muy bien el d\xEDa de hoy!"
      audioClip: {fileID: 8300000, guid: 8150cc9baea948d495b2cfddeea54513, type: 3}
  - speaker: 1
    text: "T\xFA tambi\xE9n. adi\xF3s"
    audioClip: {fileID: 0}
    hintVideoPath: MaleBaristaHints/conversation8_version2_hint7.mp4
    textVariants:
    - difficulty: 0
      text: "Adi\xF3s."
      audioClip: {fileID: 8300000, guid: 7b1f660397e3470aab5b21d0d21ece38, type: 3}
    - difficulty: 1
      text: "T\xFA tambi\xE9n. adi\xF3s"
      audioClip: {fileID: 8300000, guid: 8b66d08d752241fd9e39320de1293070, type: 3}
    - difficulty: 2
      text: "Igualmente. \xA1Hasta luego!"
      audioClip: {fileID: 8300000, guid: 2f3da35e688441d6b14e2e02678fc975, type: 3}
    - difficulty: 3
      text: "Igualmente, que te vaya bonito. \xA1Nos vemos!"
      audioClip: {fileID: 8300000, guid: 89813a9d808242df8ca6d8b60bea228e, type: 3}
