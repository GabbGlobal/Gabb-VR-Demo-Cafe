%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cd1abf5930684b46a5a64c1bedd3b33, type: 3}
  m_Name: Dialogue Lola
  m_EditorClassIdentifier: 
  linesOfDialogue:
  - speaker: 0
    text: "\xA1Hola! \xBFC\xF3mo est\xE1 usted hoy?"
    audioClip: {fileID: 8300000, guid: c0607e4bb759f423686c12aed971ad62, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xA1Hola! \xBFC\xF3mo est\xE1?"
      audioClip: {fileID: 8300000, guid: 9c2e9ebccd5c465ba708b3878fa73cf3, type: 3}
    - difficulty: 1
      text: "\xA1Hola! \xBFC\xF3mo est\xE1 usted hoy?"
      audioClip: {fileID: 8300000, guid: 83fb04caee5141a0af5ce8e0f143c97b, type: 3}
    - difficulty: 2
      text: "\xA1Hola, buenas tardes! \xBFC\xF3mo se encuentra usted hoy?"
      audioClip: {fileID: 8300000, guid: 7c68c156e2724d6b8c3c634d0c024828, type: 3}
    - difficulty: 3
      text: "\xA1Hola, qu\xE9 gusto verle! \xBFC\xF3mo se encuentra usted en este d\xEDa tan bonito?"
      audioClip: {fileID: 8300000, guid: e1338c2e97a9415ea2a0dcd87aadc923, type: 3}
  - speaker: 1
    text: "Bien gracias, \xBFy usted?"
    audioClip: {fileID: 0}
    hintVideoPath: CafeLolaHints/conversation7_version1_hint1.mp4
    textVariants:
    - difficulty: 0
      text: "Bien, \xBFy usted?"
      audioClip: {fileID: 8300000, guid: 2ec78fd569384dfb850b9c9bd7aa69a2, type: 3}
    - difficulty: 1
      text: "Bien gracias, \xBFy usted?"
      audioClip: {fileID: 8300000, guid: 8898e41fbf10491da745fb84ab064864, type: 3}
    - difficulty: 2
      text: "Muy bien, gracias por preguntar, \xBFy usted?"
      audioClip: {fileID: 8300000, guid: 99c83c9e8cd5491d98ec4a52583bfd34, type: 3}
    - difficulty: 3
      text: "De maravilla, gracias. \xBFY usted c\xF3mo anda?"
      audioClip: {fileID: 8300000, guid: bedf6609a115405fbde9a86537d7cdec, type: 3}
  - speaker: 0
    text: "\xA1Estoy genial! Ma\xF1ana viajo a casa de mi hermana."
    audioClip: {fileID: 8300000, guid: 5bcf6eaf9af504f9f979bf3e445dfb14, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xA1Muy bien! Ma\xF1ana voy a ver a mi hermana."
      audioClip: {fileID: 8300000, guid: 749de2df62264212af9c9decdfa798bd, type: 3}
    - difficulty: 1
      text: "\xA1Estoy genial! Ma\xF1ana viajo a casa de mi hermana."
      audioClip: {fileID: 8300000, guid: 03e03508264d442fab6a686b9823bccb, type: 3}
    - difficulty: 2
      text: "\xA1Estoy de maravilla! Ma\xF1ana salgo de viaje para visitar a mi hermana."
      audioClip: {fileID: 8300000, guid: e9f7dd7d5c9046408ff26f8a0c281075, type: 3}
    - difficulty: 3
      text: "\xA1Fenomenal! Ma\xF1ana me voy de viaje a visitar a mi hermana, que ya ten\xEDa
        ganas."
      audioClip: {fileID: 8300000, guid: b51728ba86f54916ad0d52b921e7c2a9, type: 3}
  - speaker: 1
    text: "\xA1Eso es genial! \xBFD\xF3nde vive?"
    audioClip: {fileID: 0}
    hintVideoPath: CafeLolaHints/conversation7_version1_hint2.mp4
    textVariants:
    - difficulty: 0
      text: "\xA1Qu\xE9 bien! \xBFD\xF3nde vive?"
      audioClip: {fileID: 8300000, guid: 2bf092580a9947129b1eb33c036500d9, type: 3}
    - difficulty: 1
      text: "\xA1Eso es genial! \xBFD\xF3nde vive?"
      audioClip: {fileID: 8300000, guid: 4b6500a9c3b34bc59e872e4b86276736, type: 3}
    - difficulty: 2
      text: "\xA1Qu\xE9 emocionante! \xBFEn d\xF3nde vive su hermana?"
      audioClip: {fileID: 8300000, guid: 3981d237ddc64a22bda98092eb231708, type: 3}
    - difficulty: 3
      text: "\xA1Qu\xE9 maravilla! \xBFY en qu\xE9 ciudad vive su hermana, si no es indiscreci\xF3n?"
      audioClip: {fileID: 8300000, guid: 467ea50a614b4d90b79ac8e1584ce02d, type: 3}
  - speaker: 0
    text: Ella vive en Boston.
    audioClip: {fileID: 8300000, guid: b8c9dc81d0bde46c8825b099d3f4b073, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: Ella vive en Boston.
      audioClip: {fileID: 8300000, guid: 8ee21d7bd4db43a4ba77405395cd330b, type: 3}
    - difficulty: 1
      text: Ella vive en Boston.
      audioClip: {fileID: 8300000, guid: 67815ba15da945ba848dd9c75a864ed9, type: 3}
    - difficulty: 2
      text: Mi hermana vive en Boston.
      audioClip: {fileID: 8300000, guid: aec33c087628444aa32275d034215b72, type: 3}
    - difficulty: 3
      text: "Vive all\xE1 en Boston, lleva ya varios a\xF1os."
      audioClip: {fileID: 8300000, guid: be1ff1c3dc7b45789cbe5f27556f138f, type: 3}
  - speaker: 1
    text: "\xBFC\xF3mo te gusta viajar?"
    audioClip: {fileID: 0}
    hintVideoPath: CafeLolaHints/conversation7_version1_hint3.mp4
    textVariants:
    - difficulty: 0
      text: "\xBFC\xF3mo viaja usted?"
      audioClip: {fileID: 8300000, guid: 592e7790357c4222ba2a95dad210df03, type: 3}
    - difficulty: 1
      text: "\xBFC\xF3mo te gusta viajar?"
      audioClip: {fileID: 8300000, guid: 7ff02a4c93af45229b84bcec7d7e01d2, type: 3}
    - difficulty: 2
      text: "\xBFY c\xF3mo prefiere usted viajar?"
      audioClip: {fileID: 8300000, guid: c962b49d0db1450695bf5a08947d561a, type: 3}
    - difficulty: 3
      text: "\xBFY qu\xE9 medio de transporte prefiere para hacer ese viaje?"
      audioClip: {fileID: 8300000, guid: faa5b4f48ef34263836ab9050c882fb7, type: 3}
  - speaker: 0
    text: "Me gusta viajar en avi\xF3n. Es r\xE1pido y f\xE1cil."
    audioClip: {fileID: 8300000, guid: c03d8a4457045446bb192a217903e27c, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "Me gusta el avi\xF3n. Es r\xE1pido."
      audioClip: {fileID: 8300000, guid: e1500c952e9547bb9cf0601be9d16f8f, type: 3}
    - difficulty: 1
      text: "Me gusta viajar en avi\xF3n. Es r\xE1pido y f\xE1cil."
      audioClip: {fileID: 8300000, guid: e330b734170e47678a45efe7ed575c10, type: 3}
    - difficulty: 2
      text: "Prefiero viajar en avi\xF3n porque es bastante r\xE1pido y c\xF3modo."
      audioClip: {fileID: 8300000, guid: bd46e1a7599b4c0cbf83b6e578a8d4a9, type: 3}
    - difficulty: 3
      text: "La verdad es que prefiero el avi\xF3n, sobre todo porque es r\xE1pido y no
        me complica la vida."
      audioClip: {fileID: 8300000, guid: 03db5df90fc34ec489d83ae5e9450991, type: 3}
  - speaker: 1
    text: "S\xED, pero es caro."
    audioClip: {fileID: 0}
    hintVideoPath: CafeLolaHints/conversation7_version1_hint4.mp4
    textVariants:
    - difficulty: 0
      text: "S\xED, pero es caro."
      audioClip: {fileID: 8300000, guid: c19290c0a6e4459a9fc4b667beb5f4f1, type: 3}
    - difficulty: 1
      text: "S\xED, pero es caro."
      audioClip: {fileID: 8300000, guid: 6830930f6da6440e947271b1f18a8ccd, type: 3}
    - difficulty: 2
      text: "S\xED, eso s\xED, aunque puede ser bastante caro."
      audioClip: {fileID: 8300000, guid: 34711d0e89bf4f7abc8b847e6a6439fe, type: 3}
    - difficulty: 3
      text: "S\xED, sin duda, aunque hay que reconocer que sale bastante caro."
      audioClip: {fileID: 8300000, guid: c45ab341a48e4c5bbd46cf90d9b54de4, type: 3}
  - speaker: 0
    text: "Eso es cierto. \xBFC\xF3mo te gusta viajar?"
    audioClip: {fileID: 8300000, guid: f445de88ee9db4c6b8c60e3ace41db69, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "S\xED. \xBFY usted?"
      audioClip: {fileID: 8300000, guid: 07bf04afdc974b12bf363229bf0a74b0, type: 3}
    - difficulty: 1
      text: "Eso es cierto. \xBFC\xF3mo te gusta viajar?"
      audioClip: {fileID: 8300000, guid: 3967f9688fc34ec2b987d533056990b7, type: 3}
    - difficulty: 2
      text: "Tiene usted raz\xF3n. \xBFY a usted c\xF3mo le gusta viajar?"
      audioClip: {fileID: 8300000, guid: 61040d4ab32e4f27a373e0b718213bfc, type: 3}
    - difficulty: 3
      text: "No le falta raz\xF3n. \xBFY usted, qu\xE9 prefiere a la hora de viajar?"
      audioClip: {fileID: 8300000, guid: f51c1ec7a4474c3384b9261ab55323c0, type: 3}
  - speaker: 1
    text: "Me gusta tomar el autob\xFAs. Es econ\xF3mico."
    audioClip: {fileID: 0}
    hintVideoPath: CafeLolaHints/conversation7_version1_hint5.mp4
    textVariants:
    - difficulty: 0
      text: "Me gusta el autob\xFAs. Es barato."
      audioClip: {fileID: 8300000, guid: f70196c2ada846778006586ef0725f38, type: 3}
    - difficulty: 1
      text: "Me gusta tomar el autob\xFAs. Es econ\xF3mico."
      audioClip: {fileID: 8300000, guid: 541f3a037d7c491785f7b235fbbb5874, type: 3}
    - difficulty: 2
      text: "Prefiero tomar el autob\xFAs porque es m\xE1s econ\xF3mico."
      audioClip: {fileID: 8300000, guid: bd849806c220449b8b2f3063ffac3c07, type: 3}
    - difficulty: 3
      text: "Yo suelo ir en autob\xFAs, la verdad, porque sale mucho m\xE1s econ\xF3mico."
      audioClip: {fileID: 8300000, guid: ffede94fe2284b6a9f30cc755238b472, type: 3}
  - speaker: 0
    text: "\xA1Oh, deber\xEDas ir a decirle a Lola d\xF3nde est\xE1 la estaci\xF3n
      de autobuses!"
    audioClip: {fileID: 8300000, guid: cc32689769be84699bc1f847001a0e59, type: 3}
    hintVideoPath: 
    textVariants:
    - difficulty: 0
      text: "\xA1Ve a decirle a Lola d\xF3nde est\xE1 la estaci\xF3n!"
      audioClip: {fileID: 8300000, guid: b74efc94598e4ab3be3271b77471e266, type: 3}
    - difficulty: 1
      text: "\xA1Oh, deber\xEDas ir a decirle a Lola d\xF3nde est\xE1 la estaci\xF3n
      de autobuses!"
      audioClip: {fileID: 8300000, guid: 334a87f8cb5048a5862c4339be6849f5, type: 3}
    - difficulty: 2
      text: "\xA1Entonces deber\xEDas ir a decirle a Lola d\xF3nde queda la estaci\xF3n
        de autobuses!"
      audioClip: {fileID: 8300000, guid: 6ab087a6c60f4f79ba8dc93774e90040, type: 3}
    - difficulty: 3
      text: "\xA1Pues no dejes de ir a decirle a Lola d\xF3nde queda la estaci\xF3n
        de autobuses, que le va a hacer falta!"
      audioClip: {fileID: 8300000, guid: 71111d2106044944a7e809ed860ee997, type: 3}
